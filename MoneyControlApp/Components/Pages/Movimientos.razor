@page "/movimientos"
@inject AuthService Auth
@inject MovimientoService MovSvc
@inject CuentaService CuentaSvc
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<MudText Typo="Typo.h5" Class="mb-3">Ingresos y gastos</MudText>

<div class="d-flex gap-2 mb-3">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="movimientos/nuevo-ingreso" FullWidth="true">+ Nuevo ingreso</MudButton>
    <MudButton Variant="Variant.Filled" Class="btn-suave" Href="movimientos/nuevo-gasto" FullWidth="true">− Nuevo gasto</MudButton>
</div>

@* Cambiar entre la lista de gastos y la de ingresos *@
<div class="selector-doble mb-3">
    <MudButton Variant="@(verGastos ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" OnClick="MostrarGastosAsync">Gastos</MudButton>
    <MudButton Variant="@(!verGastos ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" OnClick="MostrarIngresosAsync">Ingresos</MudButton>
</div>

@if (cuentas.Count > 0)
{
    <MudSelect T="int" Value="idCuentaFiltro" ValueChanged="CambiarCuentaAsync" Label="Cuenta" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
        <MudSelectItem T="int" Value="0">Todas las cuentas</MudSelectItem>
        @foreach (var c in cuentas)
        {
            <MudSelectItem T="int" Value="@c.IdCuenta">@c.NombreCuenta</MudSelectItem>
        }
    </MudSelect>
}

@if (error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@error</MudAlert>
}

@if (cargando)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (pagina is null || pagina.Items.Count == 0)
{
    <MudPaper Class="pa-4">
        <MudText>No hay @(verGastos ? "gastos" : "ingresos") registrados.</MudText>
    </MudPaper>
}
else
{
    <MudPaper Class="pa-3">
        @foreach (var m in pagina.Items)
        {
            var esIngreso = m.Tipo == "Ingreso";
            <div class="fila">
                <Circulo Texto="@Iconos.Iniciales(m.Categoria)" Tono="@Iconos.TonoCategoria(m.Categoria, esIngreso)" />
                <div class="centro">
                    <div class="texto-cortado">@(string.IsNullOrWhiteSpace(m.Descripcion) ? m.Categoria : m.Descripcion)</div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @(m.Categoria + " · " + m.Cuenta + " · " + Formato.Fecha(m.Fecha))
                    </MudText>
                </div>
                <div class="derecha">
                    <div class="@(esIngreso ? "monto-ingreso" : "monto-gasto")">@(esIngreso ? "+" : "-") @Formato.Moneda(m.Monto)</div>
                                                           <div class="acciones"><button type="button" class="btn-tacho" title="Eliminar" aria-label="Eliminar" @onclick="() => aEliminar = m"><Tacho /></button></div>
                </div>
            </div>
        }
    </MudPaper>

    <div class="d-flex justify-center mt-3">
        <MudPagination Count="@Math.Max(pagina.TotalPages, 1)" Selected="paginaActual" SelectedChanged="CambiarPaginaAsync" />
    </div>
}

@if (aEliminar is not null)
{
    <div class="aviso mt-3">
        ¿Eliminar @(aEliminar.Tipo == "Ingreso" ? "el ingreso" : "el gasto") de <strong>@Formato.Moneda(aEliminar.Monto)</strong>?
        El saldo de la cuenta se corrige solo.
        <div class="mt-2">
            <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" OnClick="EliminarAsync" Disabled="ocupado">Sí, eliminar</MudButton>
            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => aEliminar = null">Cancelar</MudButton>
        </div>
    </div>
}

@code {
    private const int TamanoPagina = 10;

    private PagedResult<MovimientoDto>? pagina;
    private List<CuentaDto> cuentas = new();
    private int paginaActual = 1;
    private int idCuentaFiltro;
    private bool verGastos = true;
    private bool cargando = true;
    private bool ocupado;
    private string? error;
    private MovimientoDto? aEliminar;

    protected override async Task OnInitializedAsync()
    {
        await Auth.InicializarAsync();
        if (!Auth.EstaLogueado)
        {
            Nav.NavigateTo("/login");
            return;
        }

        try
        {
            cuentas = await CuentaSvc.ListarAsync();
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        cargando = true;
        try
        {
            int? cuenta = idCuentaFiltro > 0 ? idCuentaFiltro : null;
            pagina = verGastos
                ? await MovSvc.GastosAsync(paginaActual, TamanoPagina, cuenta)
                : await MovSvc.IngresosAsync(paginaActual, TamanoPagina, cuenta);
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task MostrarGastosAsync()
    {
        verGastos = true;
        paginaActual = 1;
        await CargarAsync();
    }

    private async Task MostrarIngresosAsync()
    {
        verGastos = false;
        paginaActual = 1;
        await CargarAsync();
    }

    private async Task CambiarCuentaAsync(int id)
    {
        idCuentaFiltro = id;
        paginaActual = 1;
        await CargarAsync();
    }

    private async Task CambiarPaginaAsync(int nueva)
    {
        paginaActual = nueva;
        await CargarAsync();
    }

    private async Task EliminarAsync()
    {
        if (aEliminar is null) return;
        ocupado = true;
        error = null;
        try
        {
            if (aEliminar.Tipo == "Ingreso") await MovSvc.EliminarIngresoAsync(aEliminar.Id);
            else await MovSvc.EliminarGastoAsync(aEliminar.Id);

            Snackbar.Add("Movimiento eliminado. El saldo se actualizó.", Severity.Success);
            aEliminar = null;
            await CargarAsync();
        }
        catch (ApiException ex)
        {
            error = ex.Message;
            aEliminar = null;
        }
        finally
        {
            ocupado = false;
        }
    }
}
