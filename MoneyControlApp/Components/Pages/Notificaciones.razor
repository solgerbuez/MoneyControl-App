@page "/notificaciones"
@inject AuthService Auth
@inject NotificacionService Notif
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<div class="d-flex justify-space-between align-center mb-3">
    <MudText Typo="Typo.h5">Notificaciones</MudText>
    @if (listo && noLeidas > 0)
    {
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                   OnClick="MarcarTodasAsync" Disabled="ocupado">Marcar todas como leídas</MudButton>
    }
</div>

@if (!listo)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (error is not null)
{
    <MudAlert Severity="Severity.Error">@error</MudAlert>
}
else if (pagina is null || pagina.Items.Count == 0)
{
    <MudPaper Class="pa-4">
        <MudText>No tenés notificaciones. Te avisamos cuando registrás un ingreso o cuando un presupuesto llega al 90 %.</MudText>
    </MudPaper>
}
else
{
    foreach (var n in pagina.Items)
    {
        var esAlerta = n.Tipo == "PRESUPUESTO_LIMITE";
        <MudPaper Class="@(n.Leida ? "pa-3 mb-2" : "pa-3 mb-2 notif-nueva")">
            <div class="d-flex align-center gap-3">
                <Circulo Texto="@(esAlerta ? "!" : "+")" Tono="@(esAlerta ? "ambar" : "verde")" />
                <div style="flex:1;min-width:0;">
                    <div>@n.Mensaje</div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@Formato.FechaHora(n.Fecha)</MudText>
                </div>
                @if (!n.Leida)
                {
                    <button type="button" class="accion" @onclick="() => MarcarLeidaAsync(n.IdNotificacion)">Marcar leída</button>
                }
            </div>
        </MudPaper>
    }

    <div class="d-flex justify-center mt-3">
        <MudPagination Count="@Math.Max(pagina.TotalPages, 1)" Selected="paginaActual" SelectedChanged="CambiarPaginaAsync" />
    </div>
}

@code {
    private const int TamanoPagina = 20;

    private PagedResult<NotificacionDto>? pagina;
    private int paginaActual = 1;
    private int noLeidas;
    private bool listo;
    private bool ocupado;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        await Auth.InicializarAsync();
        if (!Auth.EstaLogueado)
        {
            Nav.NavigateTo("/login");
            return;
        }

        await CargarAsync();
        listo = true;
    }

    private async Task CargarAsync()
    {
        try
        {
            var r = await Notif.ListarAsync(paginaActual, TamanoPagina);
            pagina = r.Notificaciones;
            noLeidas = r.NoLeidas;
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
    }

    private async Task CambiarPaginaAsync(int nueva)
    {
        paginaActual = nueva;
        await CargarAsync();
    }

    private async Task MarcarLeidaAsync(int id)
    {
        try
        {
            await Notif.MarcarLeidaAsync(id);
            await CargarAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task MarcarTodasAsync()
    {
        ocupado = true;
        try
        {
            await Notif.MarcarTodasLeidasAsync();
            Snackbar.Add("Todas las notificaciones quedaron como leídas.", Severity.Success);
            await CargarAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            ocupado = false;
        }
    }
}
